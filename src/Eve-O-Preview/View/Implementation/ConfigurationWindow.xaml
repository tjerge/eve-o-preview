<Window x:Class="EveOPreview.View.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EveOPreview.View"
        mc:Ignorable="d"
        Title="EVE-O Preview - Configuration" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#673AB7" Padding="16">
            <TextBlock VerticalAlignment="Center" FontSize="22" Foreground="White" FontWeight="Medium" Text="EVE-O Preview Configuration"/>
        </Border>

        <!-- Content -->
        <TabControl Grid.Row="1" Margin="8">
            
            <!-- Behavior Tab -->
            <TabItem Header="🎮 Behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Behavior Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure how thumbnails and client windows behave" 
                                   TextWrapping="Wrap" 
                                   Foreground="Gray" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <!-- Window Management -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Window Management" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                
                                <CheckBox Content="Minimize to System Tray" IsChecked="{Binding MinimizeToTray}" Margin="0,8"/>
                                <TextBlock Text="Minimize the application to system tray instead of taskbar" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Minimize Inactive Clients" IsChecked="{Binding MinimizeInactiveClients}" Margin="0,8"/>
                                <TextBlock Text="Automatically minimize EVE clients when they lose focus" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Show Thumbnails Always On Top" IsChecked="{Binding ShowThumbnailsAlwaysOnTop}" Margin="0,8"/>
                                <TextBlock Text="Keep thumbnail windows above all other windows" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Hide Active Client Thumbnail" IsChecked="{Binding HideActiveClientThumbnail}" Margin="0,8"/>
                                <TextBlock Text="Don't show a thumbnail for the currently active EVE client" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Hide Login Client Thumbnail" IsChecked="{Binding HideLoginClientThumbnail}" Margin="0,8"/>
                                <TextBlock Text="Don't show thumbnails for clients at the character selection screen" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Hide Thumbnails On Lost Focus" IsChecked="{Binding HideThumbnailsOnLostFocus}" Margin="0,8"/>
                                <TextBlock Text="Hide all thumbnails when no EVE client is active" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <Grid Margin="24,0,0,8" IsEnabled="{Binding HideThumbnailsOnLostFocus}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hide Thumbnails Delay (ms):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HideThumbnailsDelay}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                               Text="Delay before hiding thumbnails when focus is lost" 
                                               FontSize="11" Foreground="Gray"/>
                                </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            
                            <!-- Right Column -->
                            <StackPanel Grid.Column="2">
                                <!-- Advanced Behavior -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Advanced Behavior" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                
                                <CheckBox Content="Enable Client Layout Tracking" IsChecked="{Binding EnableClientLayoutTracking}" Margin="0,8"/>
                                <TextBlock Text="Remember and restore the position and size of each client window" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Enable Per-Client Thumbnail Layouts" IsChecked="{Binding EnablePerClientThumbnailLayouts}" Margin="0,8"/>
                                <TextBlock Text="Allow different thumbnail positions and sizes for each client" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Enable Wine Compatibility Mode" IsChecked="{Binding EnableWineCompatibilityMode}" Margin="0,8"/>
                                <TextBlock Text="Enable compatibility fixes for running under Wine on Linux/macOS" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance Tab -->
            <TabItem Header="🎨 Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Appearance Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure how thumbnails look" 
                                   TextWrapping="Wrap" 
                                   Foreground="Gray" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <!-- Size & Dimensions -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Size &amp; Dimensions" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                
                                <TextBlock Text="Default Size" Margin="0,8,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ThumbnailWidth}"/>
                                    <TextBlock Grid.Column="3" Text="Height:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding ThumbnailHeight}"/>
                                </Grid>
                                
                                <TextBlock Text="Auto-calculate height from width:" FontSize="11" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="16:9" 
                                            Padding="12,4" 
                                            Margin="0,0,8,0"
                                            Click="SetAspectRatio16_9_Click"
                                            ToolTip="Calculate height for 16:9 aspect ratio (standard widescreen)"/>
                                    <Button Content="21:9" 
                                            Padding="12,4" 
                                            Margin="0,0,8,0"
                                            Click="SetAspectRatio21_9_Click"
                                            ToolTip="Calculate height for 21:9 aspect ratio (ultrawide)"/>
                                    <Button Content="4:3" 
                                            Padding="12,4" 
                                            Margin="0,0,8,0"
                                            Click="SetAspectRatio4_3_Click"
                                            ToolTip="Calculate height for 4:3 aspect ratio (classic)"/>
                                </StackPanel>
                                
                                <TextBlock Text="Minimum Size" Margin="0,8,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ThumbnailMinimumWidth}"/>
                                    <TextBlock Grid.Column="3" Text="Height:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding ThumbnailMinimumHeight}"/>
                                </Grid>
                                
                                <TextBlock Text="Maximum Size" Margin="0,8,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ThumbnailMaximumWidth}"/>
                                    <TextBlock Grid.Column="3" Text="Height:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding ThumbnailMaximumHeight}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Visual Style -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Visual Style" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                
                                <TextBlock Text="Opacity" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" 
                                            Minimum="0.1" Maximum="1.0" 
                                            Value="{Binding ThumbnailOpacity}"
                                            TickFrequency="0.1"
                                            TickPlacement="BottomRight"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding ThumbnailOpacity, StringFormat={}{0:P0}}" 
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               MinWidth="50"/>
                                </Grid>
                                
                                <CheckBox Content="Show Thumbnail Frames" IsChecked="{Binding ShowThumbnailFrames}" Margin="0,12,0,4"/>
                                <TextBlock Text="Display a border around each thumbnail" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <TextBlock Text="Animation Style" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding AnimationStyles}" 
                                          SelectedItem="{Binding SelectedAnimationStyle}"
                                          Margin="0,0,0,8"
                                          HorizontalAlignment="Left"
                                          MinWidth="200"/>
                                <TextBlock Text="Visual effects when showing/hiding thumbnails" 
                                           FontSize="11" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Show Thumbnail Overlays" IsChecked="{Binding ShowThumbnailOverlays}" Margin="0,8,0,4"/>
                                <TextBlock Text="Display text overlays on thumbnails (character names, system locations)" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Right Column -->
                        <StackPanel Grid.Column="2">
                            <!-- Positioning -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Positioning" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                
                                <CheckBox Content="Lock Thumbnail Location" IsChecked="{Binding LockThumbnailLocation}" Margin="0,8,0,4"/>
                                <TextBlock Text="Prevent thumbnails from being moved by dragging" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Enable Thumbnail Snap" IsChecked="{Binding EnableThumbnailSnap}" Margin="0,8,0,4"/>
                                <TextBlock Text="Snap thumbnails to nearby screen edges and other thumbnails" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <CheckBox Content="Snap to Grid" IsChecked="{Binding ThumbnailSnapToGrid}" Margin="0,8,0,4"/>
                                <TextBlock Text="Align thumbnails to an invisible grid for perfect alignment" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,8" TextWrapping="Wrap"/>
                                
                                <Grid Margin="32,4,0,8" IsEnabled="{Binding ThumbnailSnapToGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Grid X:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SnapToGridSizeX}"/>
                                    <TextBlock Grid.Column="3" Text="Grid Y:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding SnapToGridSizeY}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Zoom & Overlays Tab -->
            <TabItem Header="🔍 Zoom &amp; Overlays">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Zoom &amp; Overlay Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Enhanced visual features for thumbnails" 
                                   TextWrapping="Wrap" 
                                   Foreground="Gray" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <!-- Zoom Settings -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Zoom Settings" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                
                                <CheckBox Content="Enable Thumbnail Zoom" IsChecked="{Binding EnableThumbnailZoom}" Margin="0,8,0,4"/>
                                <TextBlock Text="Automatically enlarge thumbnails when hovering over them" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,12" TextWrapping="Wrap"/>
                                
                                <StackPanel IsEnabled="{Binding EnableThumbnailZoom}">
                                    <TextBlock Text="Zoom Factor" Margin="0,0,0,8"/>
                                    <Slider Minimum="2" Maximum="10" 
                                            Value="{Binding ThumbnailZoomFactor}"
                                            TickFrequency="1"
                                            TickPlacement="BottomRight"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding ThumbnailZoomFactor, StringFormat={}Zoom: {0}x}" 
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,16"/>
                                    
                                    <TextBlock Text="Zoom Anchor Point" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Which corner of the thumbnail stays in place when zooming" 
                                               FontSize="11" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <RadioButton Grid.Row="0" Grid.Column="0" Content="NW" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorNW}" Margin="4"/>
                                        <RadioButton Grid.Row="0" Grid.Column="1" Content="N" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorN}" Margin="4"/>
                                        <RadioButton Grid.Row="0" Grid.Column="2" Content="NE" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorNE}" Margin="4"/>
                                        
                                        <RadioButton Grid.Row="1" Grid.Column="0" Content="W" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorW}" Margin="4"/>
                                        <RadioButton Grid.Row="1" Grid.Column="1" Content="C" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorC}" Margin="4"/>
                                        <RadioButton Grid.Row="1" Grid.Column="2" Content="E" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorE}" Margin="4"/>
                                        
                                        <RadioButton Grid.Row="2" Grid.Column="0" Content="SW" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorSW}" Margin="4"/>
                                        <RadioButton Grid.Row="2" Grid.Column="1" Content="S" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorS}" Margin="4"/>
                                        <RadioButton Grid.Row="2" Grid.Column="2" Content="SE" GroupName="ZoomAnchor" IsChecked="{Binding IsZoomAnchorSE}" Margin="4"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Chatlog Path -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Chatlog Monitoring" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Chatlog Path" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding ChatlogPath}" 
                                             VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" 
                                            Content="Browse..." 
                                            Command="{Binding BrowseChatlogPathCommand}"
                                            Padding="16,4"
                                            MinWidth="100"/>
                                </Grid>
                                <TextBlock Text="Path to EVE Online chat logs directory. Auto-detected if empty." 
                                           FontSize="11" Foreground="Gray" Margin="0,4,0,2" TextWrapping="Wrap"/>
                                <TextBlock Text="Typically: C:\Users\[YourName]\Documents\EVE\logs\Chatlogs" 
                                           FontSize="11" Foreground="Gray" FontFamily="Consolas" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                            
                            <!-- Right Column -->
                            <StackPanel Grid.Column="2">
                                <!-- Overlay Settings -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Overlay Settings" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                
                                <CheckBox Content="Enable System Name Display" IsChecked="{Binding EnableSystemNameDisplay}" Margin="0,8,0,4"/>
                                <TextBlock Text="Show character system location in thumbnail overlays (requires chatlog monitoring)" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,12" TextWrapping="Wrap"/>
                                
                                <!-- Overlay Label Color -->
                                <TextBlock Text="Overlay Label Color" Margin="0,8,0,4"/>
                                <Button Content="Select Color" 
                                        Command="{Binding SelectOverlayLabelColorCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16,8"
                                        Margin="0,0,0,8">
                                    <Button.Background>
                                        <SolidColorBrush Color="{Binding OverlayLabelColor}"/>
                                    </Button.Background>
                                </Button>
                                <TextBlock Text="Color for character name overlays" 
                                           FontSize="11" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <!-- System Name Color -->
                                <TextBlock Text="System Name Color" Margin="0,8,0,4"/>
                                <Button Content="Select Color" 
                                        Command="{Binding SelectSystemNameColorCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16,8"
                                        Margin="0,0,0,8">
                                    <Button.Background>
                                        <SolidColorBrush Color="{Binding SystemNameColor}"/>
                                    </Button.Background>
                                </Button>
                                <TextBlock Text="Color for system location overlays" 
                                           FontSize="11" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <!-- Overlay Label Size -->
                                <TextBlock Text="Overlay Label Size" Margin="0,8,0,8"/>
                                <Slider Minimum="8" Maximum="32" 
                                        Value="{Binding OverlayLabelSize}"
                                        TickFrequency="2"
                                        TickPlacement="BottomRight"
                                        IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{Binding OverlayLabelSize, StringFormat={}Size: {0}pt}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,16"/>

                                <!-- Overlay Anchor -->
                                <TextBlock Text="Overlay Label Position" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Where to display the overlay text on thumbnails" 
                                           FontSize="11" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <RadioButton Grid.Row="0" Grid.Column="0" Content="NW" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorNW}" Margin="4"/>
                                    <RadioButton Grid.Row="0" Grid.Column="1" Content="N" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorN}" Margin="4"/>
                                    <RadioButton Grid.Row="0" Grid.Column="2" Content="NE" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorNE}" Margin="4"/>
                                    
                                    <RadioButton Grid.Row="1" Grid.Column="0" Content="W" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorW}" Margin="4"/>
                                    <RadioButton Grid.Row="1" Grid.Column="1" Content="C" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorC}" Margin="4"/>
                                    <RadioButton Grid.Row="1" Grid.Column="2" Content="E" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorE}" Margin="4"/>
                                    
                                    <RadioButton Grid.Row="2" Grid.Column="0" Content="SW" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorSW}" Margin="4"/>
                                    <RadioButton Grid.Row="2" Grid.Column="1" Content="S" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorS}" Margin="4"/>
                                    <RadioButton Grid.Row="2" Grid.Column="2" Content="SE" GroupName="OverlayAnchor" IsChecked="{Binding IsOverlayAnchorSE}" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Highlighting Tab -->
            <TabItem Header="✨ Highlighting">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Active Client Highlighting" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Visual client identification with colored borders" 
                                   TextWrapping="Wrap" 
                                   Foreground="Gray" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <!-- Global Highlight Settings -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Default Highlight" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                
                                <CheckBox Content="Enable Active Client Highlight" IsChecked="{Binding EnableActiveClientHighlight}" Margin="0,8,0,4"/>
                                <TextBlock Text="Draw a colored border around the active client's thumbnail" 
                                           FontSize="11" Foreground="Gray" Margin="24,0,0,12" TextWrapping="Wrap"/>
                                
                                <StackPanel IsEnabled="{Binding EnableActiveClientHighlight}">
                                    <TextBlock Text="Highlight Color" Margin="0,8,0,4"/>
                                    <Button Content="Select Color" 
                                            Command="{Binding SelectHighlightColorCommand}"
                                            HorizontalAlignment="Left"
                                            Padding="16,8"
                                            Margin="0,0,0,8">
                                        <Button.Background>
                                            <SolidColorBrush Color="{Binding ActiveClientHighlightColor}"/>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="Default highlight color (used when no per-client color is set)" 
                                               FontSize="11" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <TextBlock Text="Highlight Thickness" Margin="0,8,0,8"/>
                                    <Slider Minimum="1" Maximum="20" 
                                            Value="{Binding ActiveClientHighlightThickness}"
                                            TickFrequency="1"
                                            TickPlacement="BottomRight"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding ActiveClientHighlightThickness, StringFormat={}Thickness: {0}px}" 
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            
                            <!-- Right Column -->
                            <StackPanel Grid.Column="2">
                                <!-- Per-Client Highlight Colors -->
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Per-Client Custom Highlights" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Assign unique highlight colors to specific EVE clients for quick visual identification" 
                                           TextWrapping="Wrap" 
                                           Foreground="Gray" 
                                           Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="+ Add Client Highlight Color" 
                                            Command="{Binding AddPerClientHighlightColorCommand}"
                                            Padding="12,6"
                                            Margin="0,0,8,0"/>
                                    <Button Content="📋 Populate from Open Clients" 
                                            Command="{Binding PopulateHighlightColorsFromOpenClientsCommand}"
                                            Padding="12,6"
                                            ToolTip="Add entries for all currently running EVE clients"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding PerClientHighlightColors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Client:" VerticalAlignment="Center" Margin="0,0,8,0" Width="50"/>
                                                <TextBox Grid.Column="1" 
                                                         Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         Margin="0,0,8,0"
                                                         ToolTip="Enter the exact client window name (e.g., 'EVE - Main Character')"/>

                                                <Button Grid.Column="3" 
                                                        Content="Select Color"
                                                        Padding="16,8"
                                                        Margin="0,0,8,0"
                                                        Click="SelectPerClientHighlightColor_Click"
                                                        Tag="{Binding}">
                                                    <Button.Background>
                                                        <SolidColorBrush Color="{Binding HighlightColor, Mode=OneWay}"/>
                                                    </Button.Background>
                                                </Button>

                                                <Button Grid.Column="4" 
                                                        Content="Remove"
                                                        Padding="12,4"
                                                        Click="RemovePerClientHighlightColor_Click"
                                                        Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab (Merged: Group Hotkeys + Per-Client Hotkeys) -->
            <TabItem Header="⌨️ Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Keyboard Shortcuts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure hotkeys to quickly focus specific EVE clients" 
                                   TextWrapping="Wrap" 
                                   Foreground="Gray" 
                                   Margin="0,0,0,8"/>
                        
                        <!-- Per-Client Hotkeys -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Per Client Hotkeys" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Assign hotkeys to instantly focus specific EVE clients" 
                                           TextWrapping="Wrap" 
                                           Foreground="Gray" 
                                           Margin="0,0,0,8"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="+ Add Client Hotkey" 
                                            Command="{Binding AddPerClientHotkeyCommand}"
                                            Padding="12,6"
                                            Margin="0,0,8,0"/>
                                    <Button Content="📋 Populate from Open Clients" 
                                            Command="{Binding PopulateFromOpenClientsCommand}"
                                            Padding="12,6"
                                            ToolTip="Add entries for all currently running EVE clients"/>
                                </StackPanel>
                                
                                <ItemsControl ItemsSource="{Binding PerClientHotkeys}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="Client:" VerticalAlignment="Center" Margin="0,0,8,0" Width="50"/>
                                                <TextBox Grid.Column="1" 
                                                         Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         Margin="0,0,8,0"
                                                         ToolTip="Enter the exact client window name (e.g., 'EVE - Main Character')"/>
                                                
                                                <TextBlock Grid.Column="2" Text="Hotkey:" VerticalAlignment="Center" Margin="0,0,8,0" Width="50"/>
                                                <local:MultiHotkeyControl Grid.Column="3" 
                                                                          Hotkeys="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"
                                                                          Margin="0,0,8,0"/>
                                                
                                                <Button Grid.Column="4" 
                                                        Content="Remove"
                                                        Padding="12,4"
                                                        Click="RemovePerClientHotkey_Click"
                                                        Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Client Cycling Groups -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Client Cycling Groups" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Configure up to 5 groups of hotkeys to cycle through different sets of EVE clients" 
                                           TextWrapping="Wrap" 
                                           Foreground="Gray" 
                                           Margin="0,0,0,8"/>

                                <!-- Cycle Group 1 -->
                                <Expander Header="Cycle Group 1" IsExpanded="True" Margin="0,2">
                                    <StackPanel Margin="12,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Forward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup1ForwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Backward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup1BackwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <TextBlock Text="Client Order (one per line)" Margin="0,6,0,2"/>
                                        <TextBox Text="{Binding CycleGroup1ClientsOrder, UpdateSourceTrigger=PropertyChanged}" 
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="50"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="Example:&#x0a;EVE - Main Character&#x0a;EVE - Alt Character&#x0a;EVE - Another Alt"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Cycle Group 2 -->
                                <Expander Header="Cycle Group 2" IsExpanded="False" Margin="0,2">
                                    <StackPanel Margin="12,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Forward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup2ForwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Backward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup2BackwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <TextBlock Text="Client Order (one per line)" Margin="0,6,0,2"/>
                                        <TextBox Text="{Binding CycleGroup2ClientsOrder, UpdateSourceTrigger=PropertyChanged}" 
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="50"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Cycle Group 3 -->
                                <Expander Header="Cycle Group 3" IsExpanded="False" Margin="0,2">
                                    <StackPanel Margin="12,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Forward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup3ForwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Backward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup3BackwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <TextBlock Text="Client Order (one per line)" Margin="0,6,0,2"/>
                                        <TextBox Text="{Binding CycleGroup3ClientsOrder, UpdateSourceTrigger=PropertyChanged}" 
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="50"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Cycle Group 4 -->
                                <Expander Header="Cycle Group 4" IsExpanded="False" Margin="0,2">
                                    <StackPanel Margin="12,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Forward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup4ForwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Backward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup4BackwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <TextBlock Text="Client Order (one per line)" Margin="0,6,0,2"/>
                                        <TextBox Text="{Binding CycleGroup4ClientsOrder, UpdateSourceTrigger=PropertyChanged}" 
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="50"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Cycle Group 5 -->
                                <Expander Header="Cycle Group 5" IsExpanded="False" Margin="0,2">
                                    <StackPanel Margin="12,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Forward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup5ForwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Backward Hotkeys" Margin="0,0,0,2"/>
                                                <local:MultiHotkeyControl Hotkeys="{Binding CycleGroup5BackwardHotkeys, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <TextBlock Text="Client Order (one per line)" Margin="0,6,0,2"/>
                                        <TextBox Text="{Binding CycleGroup5ClientsOrder, UpdateSourceTrigger=PropertyChanged}" 
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="50"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About Tab -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32" MaxWidth="600" HorizontalAlignment="Center">
                        <!-- Name and Version -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="EVE-O-Preview" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding VersionText}" 
                                       FontSize="20" 
                                       FontWeight="Bold"/>
                        </StackPanel>
                        
                        <!-- Description -->
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" TextAlignment="Center">
                            <Run>An advanced task switcher for EVE Online clients.</Run>
                            <LineBreak/><LineBreak/>
                            <Run FontWeight="SemiBold">The program does NOT</Run>
                            <LineBreak/>
                            <Run>• modify EVE Online interface</Run>
                            <LineBreak/>
                            <Run>• display modified EVE Online interface</Run>
                            <LineBreak/>
                            <Run>• broadcast any keyboard or mouse events</Run>
                            <LineBreak/>
                            <Run>• interact with EVE Online except of;</Run>
                            <LineBreak/>
                            <Run>    - resizing or bringing it to the foreground</Run>
                        </TextBlock>
                        
                        <!-- Credit to previous maintainer -->
                        <TextBlock Text="Credit to previous maintainer: Phrynohyas Tig-Rah" 
                                   Margin="0,0,0,8"
                                   TextAlignment="Center"/>
                        
                        <!-- Documentation Link Label -->
                        <TextBlock Text="For more information visit the forum thread:" 
                                   Margin="0,0,0,8"
                                   TextAlignment="Center"/>
                        
                        <!-- Documentation Link Button -->
                        <Button Content="View Documentation" 
                                Command="{Binding OpenDocumentationCommand}"
                                Padding="16,8"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="APPLY" 
                        Command="{Binding ApplyCommand}"
                        Padding="16,8"
                        Margin="8,0"
                        MinWidth="100"/>
                <Button Content="CANCEL" 
                        Command="{Binding CancelCommand}"
                        Padding="16,8"
                        Margin="8,0,0,0"
                        MinWidth="100"/>
                <Button Content="OK" 
                        Command="{Binding SaveCommand}"
                        Padding="16,8"
                        Margin="8,0,0,0"
                        MinWidth="100"
                        Background="#673AB7"
                        Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
